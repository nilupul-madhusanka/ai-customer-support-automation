GEMINI_API_KEY=replace_with_your_key
GEMINI_MODEL=gemini-3.8-flash
# Discover general-purpose text models available to this API key automatically.
GEMINI_AUTO_DISCOVER=true
# Optional preferred fallbacks, tried before automatically discovered candidates.
GEMINI_FALLBACK_MODELS=
GEMINI_MAX_ATTEMPTS=3
GEMINI_TIME_BUDGET_SECONDS=90
DATA_SOURCE=sheets
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json
READ_ONLY=false
ANALYSIS_AUDIT_PATH=var/analysis_attempts.jsonl
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
